<details class="pak-faq-item" {{ block.shopify_attributes }}>
  <summary class="pak-faq-item__summary">
    <span class="pak-faq-item__question">{{ block.settings.question }}</span>
    <span class="pak-faq-item__icon" aria-hidden="true"></span>
  </summary>
  {%- if block.settings.answer != blank -%}
    <div class="pak-faq-item__answer">{{ block.settings.answer }}</div>
  {%- endif -%}
</details>

{% stylesheet %}
  .pak-faq-item {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .pak-faq-item__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px;
    cursor: pointer;
    list-style: none;
  }

  .pak-faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .pak-faq-item__question {
    font-family: var(--font-body--family);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .pak-faq-item__icon {
    position: relative;
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    color: var(--pak-color-accent, #9c7a52);
  }

  .pak-faq-item__icon::before,
  .pak-faq-item__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    transition: transform 0.2s ease;
  }

  .pak-faq-item__icon::before {
    width: 8px;
    height: 1.5px;
    translate: -50% -50%;
  }

  .pak-faq-item__icon::after {
    width: 1.5px;
    height: 8px;
    translate: -50% -50%;
  }

  details[open] .pak-faq-item__icon::after {
    transform: rotate(90deg) scaleX(0);
  }

  .pak-faq-item__answer {
    padding: 0 14px 14px;
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-foreground-subdued, var(--color-foreground));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ item",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "Question"
    },
    {
      "type": "textarea",
      "id": "answer",
      "label": "Answer",
      "default": "Answer"
    }
  ],
  "presets": [
    {
      "name": "FAQ item",
      "category": "t:categories.basic",
      "settings": {
        "question": "Question",
        "answer": "Answer"
      }
    }
  ]
}
{% endschema %}
