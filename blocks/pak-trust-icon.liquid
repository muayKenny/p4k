{% assign block_settings = block.settings %}

<div class="pak-trust-icon" {{ block.shopify_attributes }}>
  <span class="pak-trust-icon__badge">
    <span class="pak-trust-icon__media" style="width: {{ block_settings.width }}px; height: {{ block_settings.width }}px;">
      {%- case block_settings.icon -%}
        {%- when 'pak_spine' -%}
          {% render 'pak-icon-spine' %}
        {%- when 'pak_vet' -%}
          {% render 'pak-icon-vet' %}
        {%- when 'pak_mushroom' -%}
          {% render 'pak-icon-mushroom' %}
        {%- else -%}
          {% render 'icon-or-image',
            icon: block_settings.icon,
            image_upload: block_settings.image_upload,
            width: block_settings.width,
            class_name: 'pak-trust-icon__media-fallback'
          %}
      {%- endcase -%}
    </span>
  </span>
  <span class="pak-trust-icon__label">{{ block_settings.label }}</span>
</div>

{% stylesheet %}
  .pak-trust-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .pak-trust-icon__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--pak-color-badge-background, #ffefcd);
  }

  .pak-trust-icon__media {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
  }

  .pak-trust-icon__media-fallback {
    width: 100%;
    height: 100%;
  }

  .pak-trust-icon__label {
    font-family: var(--font-body--family);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust icon",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "pak_spine", "label": "Spine (custom)" },
        { "value": "pak_vet", "label": "Vet shield (custom)" },
        { "value": "pak_mushroom", "label": "Lab flask (custom)" },
        { "value": "none", "label": "None" },
        { "value": "heart", "label": "Heart" },
        { "value": "check_box", "label": "Check" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "plant", "label": "Plant" },
        { "value": "lightning_bolt", "label": "Lightning bolt" },
        { "value": "lock", "label": "Lock" },
        { "value": "star", "label": "Star" },
        { "value": "eye", "label": "Eye" },
        { "value": "paw_print", "label": "Paw print" }
      ],
      "default": "pak_spine"
    },
    {
      "type": "image_picker",
      "id": "image_upload",
      "label": "Custom icon image"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Icon size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Trust point"
    }
  ],
  "presets": [
    {
      "name": "Trust icon",
      "category": "t:categories.basic",
      "settings": {
        "icon": "heart",
        "label": "Trust point"
      }
    }
  ]
}
{% endschema %}
