<div class="pak-faq spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="pak-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="pak-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pak-faq__list">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .pak-faq {
    display: block;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .pak-faq__inner {
    max-width: 480px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .pak-faq__heading {
    margin: 0 0 20px;
    text-align: center;
    font-family: var(--font-h2--family, var(--font-h1--family));
    font-size: 22px;
  }

  .pak-faq__list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PAK FAQ",
  "class": "pak-faq-section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "pak-faq-item"
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "PAK FAQ",
      "category": "t:categories.storytelling",
      "blocks": {
        "faq_1": {
          "type": "pak-faq-item",
          "settings": {
            "question": "How many chews should I give my dog?",
            "answer": "Most dogs do well with 1–2 chews daily, based on weight. Full dosing guidance is included with every order."
          }
        },
        "faq_2": {
          "type": "pak-faq-item",
          "settings": {
            "question": "How long until I see results?",
            "answer": "Many pet parents notice a difference within 4–6 weeks, though timelines vary depending on your dog's condition and history."
          }
        },
        "faq_3": {
          "type": "pak-faq-item",
          "settings": {
            "question": "Is it safe with other medications?",
            "answer": "Our formula is generally well-tolerated alongside most medications, but we recommend checking with your vet if your dog is on prescription treatment."
          }
        },
        "faq_4": {
          "type": "pak-faq-item",
          "settings": {
            "question": "What if it doesn't work for my dog?",
            "answer": "You're covered by our 90-Day Money-Back Guarantee — if you don't see results, we'll refund you, no questions asked."
          }
        },
        "faq_5": {
          "type": "pak-faq-item",
          "settings": {
            "question": "What breeds is this formulated for?",
            "answer": "It's formulated for all dog breeds and sizes, with dosing calibrated by weight."
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3", "faq_4", "faq_5"]
    }
  ]
}
{% endschema %}
