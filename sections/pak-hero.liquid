<div
  class="pak-hero"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="pak-hero__inner">
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="pak-hero__eyebrow">{{ section.settings.eyebrow_text }}</p>
    {%- endif -%}

    {%- if section.settings.trust_line != blank -%}
      <p class="pak-hero__trust-line">{{ section.settings.trust_line }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="pak-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="pak-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="pak-hero__media">
      {% render 'pak-before-after',
        before_image: section.settings.before_image,
        before_label: section.settings.before_label,
        after_image: section.settings.after_image,
        after_label: section.settings.after_label,
        badge_text: section.settings.promo_badge_text
      %}
    </div>

    <div class="pak-hero__cta">
      {% content_for 'block', type: 'button', id: 'hero_cta' %}
    </div>

    {%- if section.settings.guarantee_text != blank -%}
      <p class="pak-hero__guarantee">{{ section.settings.guarantee_text }}</p>
    {%- endif -%}

    <div class="pak-hero__trust-icons">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .pak-hero {
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .pak-hero__inner {
    max-width: 480px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    padding-inline: 20px;
  }

  .pak-hero__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.05em;
  }

  .pak-hero__trust-line {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 14px;
    color: var(--color-foreground-subdued, var(--color-foreground));
  }

  .pak-hero__heading {
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
    font-family: var(--font-h1--family);
    font-size: 29px;
    line-height: 1.18;
  }

  .pak-hero__subheading {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-foreground-subdued, var(--color-foreground));
  }

  .pak-hero__media {
    width: 100%;
    margin-block-end: 32px;
  }

  .pak-hero__cta {
    width: 100%;
  }

  .pak-hero__guarantee {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 700;
    color: var(--pak-color-accent, var(--color-foreground));
  }

  .pak-hero__trust-icons {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding-block-start: 8px;
    width: 100%;
  }

  .pak-hero__trust-icons .pak-trust-icon {
    flex: 1 1 0;
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PAK Hero",
  "class": "pak-hero-section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "PETS ARE KIDS TOO"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "Trusted by 10,000+ Dog Parents ⭐⭐⭐⭐⭐"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Natural Way to Protect Your Dog's Spine"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Slow DM's progression and restore mobility without surgery or side effects."
    },
    {
      "type": "header",
      "content": "Before / after images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before badge label",
      "default": "BEFORE"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After badge label",
      "default": "AFTER"
    },
    {
      "type": "text",
      "id": "promo_badge_text",
      "label": "Floating promo badge",
      "default": "35% Off + Free Gifts",
      "info": "Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Guarantee"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "90-Day Money-Back Guarantee"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    { "type": "button" },
    { "type": "pak-trust-icon" }
  ],
  "presets": [
    {
      "name": "PAK Hero",
      "category": "t:categories.storytelling",
      "blocks": {
        "hero_cta": {
          "type": "button",
          "static": true,
          "settings": {
            "label": "Start Protecting My Dog's Spine",
            "link": "shopify://collections/all",
            "style_class": "button",
            "width": "custom",
            "custom_width": 100
          }
        },
        "trust_1": {
          "type": "pak-trust-icon",
          "settings": {
            "icon": "heart",
            "label": "Supports Nerve & Spine Health"
          }
        },
        "trust_2": {
          "type": "pak-trust-icon",
          "settings": {
            "icon": "check_box",
            "label": "Vet-Formulated"
          }
        },
        "trust_3": {
          "type": "pak-trust-icon",
          "settings": {
            "icon": "leaf",
            "label": "7 Clinically-Studied Mushrooms"
          }
        }
      },
      "block_order": ["trust_1", "trust_2", "trust_3"]
    }
  ]
}
{% endschema %}
